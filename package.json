{
  "name": "agent-sandbox",
  "version": "0.1.0",
  "description": "Policy-enforced sandbox for running AI agent tasks: tool gateway, filesystem and network policy, canary secrets, container isolation and structured traces.",
  "type": "module",
  "license": "MIT",
  "author": "Aziz Coban",
  "bin": {
    "agent-sandbox": "dist/cli.js"
  },
  "files": [
    "dist",
    "policies",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sandbox": "tsx src/cli.ts"
  },
  "keywords": [
    "ai-agents",
    "sandbox",
    "agent-security",
    "prompt-injection",
    "policy",
    "canary-tokens"
  ],
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
